@page "/Games/{id:int}"
@model GamesInfoSys.Pages.Games.DetailsModel
@{
    ViewData["Title"] = Model.Game?.Name ?? "Game";
}

@if (Model.Game is null)
{
    <div class="alert alert-warning">Game not found.</div>
    <a class="btn btn-outline-secondary" asp-page="/Games/Index">Back</a>
}
else
{
    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="card">
                @if (!string.IsNullOrWhiteSpace(Model.Game.BackgroundImage))
                {
                    <img class="card-img-top gis-cover" src="@Model.Game.BackgroundImage" alt="@Model.Game.Name cover"
                         onerror="this.onerror=null;this.src='/img/cover-placeholder.svg';" />
                }
                else
                {
                    <img class="card-img-top gis-cover" src="/img/cover-placeholder.svg" alt="@Model.Game.Name cover" />
                }
                <div class="card-body">
                    <h1 class="h4 mb-2">@Model.Game.Name</h1>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (!string.IsNullOrWhiteSpace(Model.Game.Released))
                        {
                            <span class="badge text-bg-light border">Released: @Model.Game.Released</span>
                        }
                        @if (Model.Game.Metacritic is not null)
                        {
                            <span class="badge text-bg-light border">Metacritic: @Model.Game.Metacritic</span>
                        }
                        @if (Model.Game.Rating is not null)
                        {
                            <span class="badge text-bg-light border">Rating: ★ @Model.Game.Rating</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Game.Website))
                    {
                        <div class="mb-3">
                            <a class="btn btn-sm btn-primary w-100" href="@Model.Game.Website" target="_blank" rel="noreferrer">Official website</a>
                        </div>
                    }

                    <a class="btn btn-outline-secondary w-100" asp-page="/Games/Index">Back to browse</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h2 class="h5 mb-1">Prices (Region: UA, Switch: ZA)</h2>
                            <div class="text-body-secondary small">Official stores only (current MVP). Add identifiers to enable more platforms.</div>
                        </div>
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Games/Index">Browse</a>
                    </div>

                    @if (Model.IsDemoMode && Model.Game.ExternalStores.Count > 0)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            Demo mode note: store buttons below come from the demo JSON (not live platform APIs).
                        </div>
                    }

                    @if (Model.Game.ExternalStores.Count > 0)
                    {
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            @foreach (var s in Model.Game.ExternalStores)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@s.Url" target="_blank" rel="noreferrer">Open @s.Store</a>
                            }
                        </div>
                    }

                    @if (Model.BestMarketplaceOffer is not null && Model.BestMarketplaceOffer.PriceMinor is not null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            Best marketplace deal: <strong>@FormatMoney(Model.BestMarketplaceOffer.PriceMinor.Value, Model.BestMarketplaceOffer.Currency ?? "USD")</strong>
                            @if (Model.OfferUahMajor.TryGetValue(Model.BestMarketplaceOffer.Id, out var uah) && uah is not null)
                            {
                                <span class="ms-2">(≈ @($"{uah.Value:0.00} UAH"))</span>
                            }
                            <a class="ms-2" href="@Model.BestMarketplaceOffer.Url" target="_blank" rel="noreferrer">Open</a>
                        </div>
                    }

                    @if (Model.Offers.Count == 0)
                    {
                        <div class="alert alert-info mt-3 mb-0">No offers yet. If RAWG provides a Steam link it will be detected automatically; otherwise add a Steam App ID below.</div>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Platform</th>
                                        <th>Store</th>
                                        <th>Region</th>
                                        <th>Price</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in Model.Offers)
                                    {
                                        var isMarketplace = o.Store == "CheapShark";
                                        <tr>
                                            <td>@o.Platform</td>
                                            <td>
                                                @o.Store
                                                @if (isMarketplace)
                                                {
                                                    <span class="badge text-bg-warning ms-2">Marketplace</span>
                                                }
                                            </td>
                                            <td>@o.Region</td>
                                            <td>
                                                @if (o.PriceMinor is null || string.IsNullOrWhiteSpace(o.Currency))
                                                {
                                                    <span class="text-body-secondary">—</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-semibold">@FormatMoney(o.PriceMinor.Value, o.Currency)</span>
                                                    @if (o.OriginalPriceMinor is not null && o.OriginalPriceMinor.Value > o.PriceMinor.Value)
                                                    {
                                                        <span class="text-body-secondary ms-2"><s>@FormatMoney(o.OriginalPriceMinor.Value, o.Currency)</s></span>
                                                    }

                                                    if (o.Currency != "UAH" && Model.OfferUahMajor.TryGetValue(o.Id, out var uah) && uah is not null)
                                                    {
                                                        <div class="small text-body-secondary mt-1">≈ @($"{uah.Value:0.00} UAH")</div>
                                                    }
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-primary" href="@o.Url" target="_blank" rel="noreferrer">
                                                    @(isMarketplace ? "Open deal" : "Open")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="border-top pt-3 mt-3">
                        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                            <h3 class="h6 mb-0">Steam mapping (optional)</h3>
                            <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#steamMap" aria-expanded="false" aria-controls="steamMap">
                                Add / change
                            </button>
                        </div>

                        <div class="collapse mt-3" id="steamMap">
                            <form method="post" asp-page-handler="SetSteam" class="row g-2 align-items-end">
                                <div class="col-12 col-md-8">
                                    <label class="form-label" asp-for="SteamAppIdOrUrl">Steam link or App ID</label>
                                    <input class="form-control" asp-for="SteamAppIdOrUrl" placeholder="https://store.steampowered.com/app/1245620/  or  1245620" />
                                    <div class="text-danger small"><span asp-validation-for="SteamAppIdOrUrl"></span></div>
                                    <div class="form-text">Tip: open Steam in browser and copy the URL.</div>
                                </div>
                                <div class="col-12 col-md-auto">
                                    <button class="btn btn-outline-primary" type="submit">Save & refresh</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">About</h2>
                    <p class="mb-0">
                        @(Model.Game.DescriptionPlain ?? "No description available.")
                    </p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Find in Ukraine</h2>
                    <div class="text-body-secondary small mb-3">Quick searches for physical copies or gift cards. Prices may differ by edition/platform.</div>

                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noreferrer"
                           href="@BuildSearchUrl("https://rozetka.com.ua/search/?text=", Model.GameNameForSearch)">
                            Rozetka
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noreferrer"
                           href="@BuildSearchUrl("https://prom.ua/ua/search?search_term=", Model.GameNameForSearch)">
                            Prom.ua
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noreferrer"
                           href="@BuildSearchUrl("https://www.olx.ua/d/uk/list/q-", Slugify(Model.GameNameForSearch))">
                            OLX
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noreferrer"
                           href="@BuildSearchUrl("https://www.youtube.com/results?search_query=", Model.GameNameForSearch + " review")">
                            YouTube review
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noreferrer"
                           href="@BuildSearchUrl("https://www.youtube.com/results?search_query=", Model.GameNameForSearch + " gameplay")">
                            YouTube gameplay
                        </a>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Genres</h2>
                            @if (Model.Game.Genres.Count == 0)
                            {
                                <div class="text-body-secondary">—</div>
                            }
                            else
                            {
                                <div class="gis-tags">
                                    @foreach (var x in Model.Game.Genres)
                                    {
                                        <span class="badge text-bg-light border">@x</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h6">Platforms</h2>
                            @if (Model.Game.Platforms.Count == 0)
                            {
                                <div class="text-body-secondary">—</div>
                            }
                            else
                            {
                                <div class="gis-tags">
                                    @foreach (var x in Model.Game.Platforms)
                                    {
                                        <span class="badge text-bg-light border">@x</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.IsDemoMode && Model.Screenshots.Count > 0)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Screenshots</h2>
                        <div class="row g-2">
                            @foreach (var s in Model.Screenshots)
                            {
                                if (string.IsNullOrWhiteSpace(s.Image)) { continue; }
                                <div class="col-6 col-md-4">
                                    <a href="@s.Image" target="_blank" rel="noreferrer">
                                        <img class="img-fluid rounded gis-shot" src="@s.Image" alt="Screenshot" loading="lazy" />
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@functions {
    private static string FormatMoney(long minor, string currency)
    {
        // Steam returns minor units (e.g. cents/kopeks).
        var major = minor / 100m;
        return $"{major:0.00} {currency}";
    }

    private static string BuildSearchUrl(string prefix, string query)
    {
        query ??= "";
        return prefix + Uri.EscapeDataString(query);
    }

    private static string Slugify(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";
        value = value.Trim();
        value = value.Replace('’', '\'').Replace('–', '-').Replace('—', '-');
        value = System.Text.RegularExpressions.Regex.Replace(value, "\\s+", "-");
        value = System.Text.RegularExpressions.Regex.Replace(value, "[^a-zA-Z0-9\\-]+", "");
        return value.ToLowerInvariant();
    }
}
