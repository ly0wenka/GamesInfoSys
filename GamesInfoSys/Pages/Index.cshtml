@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 rounded text-bg-dark gis-hero">
    <div class="col-lg-8 px-0">
        <h1 class="display-5 fw-semibold">Game Info Aggregator</h1>
        <p class="lead my-3">Search and browse games, open details, and keep everything in one place.</p>
        <p class="lead mb-0">
            <a class="btn btn-primary btn-lg" asp-page="/Games/Index">Browse games</a>
        </p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Fast search</h2>
                <p class="text-body-secondary mb-0">Type a title and jump straight to a game page.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Demo mode</h2>
                <p class="text-body-secondary mb-0">Works without API keys; add a RAWG key later for live data.</p>
            </div>
        </div>
    </div>
</div>
