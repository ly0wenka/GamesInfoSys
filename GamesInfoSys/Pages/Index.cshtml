@page
@model IndexModel
@{
    ViewData["Title"] = Text["HomeTitle"];
}

<div class="p-4 p-md-5 mb-4 rounded text-bg-dark gis-hero">
    <div class="col-lg-8 px-0">
        <h1 class="display-5 fw-semibold">@Text["HeroTitle"]</h1>
        <p class="lead my-3">@Text["HeroText"]</p>
        <p class="lead mb-0">
            <a class="btn btn-primary btn-lg" asp-page="/Games/Index">@Text["BrowseGames"]</a>
        </p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">@Text["FastSearch"]</h2>
                <p class="text-body-secondary mb-0">@Text["FastSearchText"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">@Text["DemoMode"]</h2>
                <p class="text-body-secondary mb-0">@Text["DemoModeText"]</p>
            </div>
        </div>
    </div>
</div>
