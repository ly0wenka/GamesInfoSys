@page
@model ErrorModel
@{
    ViewData["Title"] = Text["ErrorTitle"];
}

<h1 class="text-danger">@Text["ErrorHeading"]</h1>
<h2 class="text-danger">@Text["ErrorText"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Text["RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Text["DevelopmentMode"]</h3>
<p>@Text["DevelopmentModeText1"]</p>
<p>
    <strong>@Text["DevelopmentModeText2"]</strong>
    @Text["DevelopmentModeText3"]
    @Text["DevelopmentModeText4"]
</p>
