{
  "Rawg": {
    "ApiKey": "",
    "BaseUrl": "https://api.rawg.io/api/",
    "UseDemoDataWhenNoApiKey": true
  },
  "Pricing": {
    "DefaultRegion": "UA",
    "PlatformRegions": {
      "Switch": "ZA"
    },
    "PreferredCurrency": "UAH"
  },
  "Currency": {
    "NbuBaseUrl": "https://bank.gov.ua/"
  },
  "Scraping": {
    "Enabled": true,
    "MaxResultsPerStore": 8,
    "CacheMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
